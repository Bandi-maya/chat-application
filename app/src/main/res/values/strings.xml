    <string name="about_accessibility_help_title">Trouble enabling accessibility?</string>
    <string name="about_accessibility_help_body">The cross-app island is optional. You can use overlay access instead of the accessibility host. If Android blocks special access, keep it off while you verify this build and the installer warning. Turning the island off does not revoke access in Android Settings.</string>
    <string name="about_background_title">Island stops in the background?</string>
    <string name="about_background_strict_warning">Background restrictions on this device may stop the island.</string>
    <string name="about_background_body">Exclude Chaty from battery optimization and lock it in recents. Some OEMs also need "Autostart" or "Allow background activity" enabled.</string>
    <string name="about_dontkillmyapp">dontkillmyapp.com</string>

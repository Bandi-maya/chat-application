    <string name="onboarding_accessibility_title">Optional accessibility host</string>
    <string name="onboarding_accessibility_why">Optional host for a tappable island above other apps. The configuration does not retrieve screen content or inject gestures. Overlay access is an alternative.</string>
    <string name="onboarding_accessibility_deferred">Covered for now by the overlay permission; you can enable accessibility later for the best experience.</string>
    <string name="onboarding_overlay_title">Display over other apps</string>
    <string name="onboarding_overlay_why">Alternative to the accessibility service: lets the island float above other apps.</string>
    <string name="onboarding_overlay_action">Open overlay settings</string>
    <string name="onboarding_listener_title">Optional notification access</string>
    <string name="onboarding_listener_why">Optional access to notification text, actions and media-session information for the cross-app island. Ordinary messaging does not need it.</string>

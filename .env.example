# Public routing values supplied by the user. No credentials or secrets.
# Copy to ignored root .env to make Kotlin's build-time overrides explicit.
# The same values are centralized fallbacks in BackendRoutingPolicy.kt.
REST_API_BASE_URL=https://api.hub.logybyte.in
WEBSOCKET_URL=wss://api.hub.logybyte.in/api/chat/ws{userId}
TENANT_ID=chat-application

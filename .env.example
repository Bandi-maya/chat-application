# Public client routing only, compiled into the APK. No credentials or secrets.
# Kotlin reads this root .env at build time. See docs/KOTLIN_CONFIGURATION.md.
# Copy to .env (ignored); set your existing phone-reachable backend endpoint.
# Empty values use the user-supplied public defaults in BackendRoutingPolicy.kt.
REST_API_BASE_URL=
TENANT_ID=
# Empty WS uses the central template; override here only if needed.
WEBSOCKET_URL=
